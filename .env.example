# ─── Awaqi Environment Variables ───────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env

# ─── Database (PostgreSQL + pgvector) ─────────────────────────────────────────
# Spin up DB only: docker compose -f docker/docker-compose.db.yml up -d
# Used by Docker Compose to create the database
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=awaqi_db

# Used by the Python backend (must match the Docker Compose values above)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/awaqi_db
# Used by the Next.js frontend (Better Auth needs a sync driver)
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/awaqi_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Google AI (Gemini) ───────────────────────────────────────────────────────
# Required for RAG embeddings (ingest + retrieval) and optional chat generation
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here
# Optional Gemini embedding overrides (defaults: gemini-embedding-001 @ 3072-d)
# Native 3072-d vectors require the DB schema to use vector(3072).
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_EMBEDDING_DIMENSION=3072
# GEMINI_EMBED_BATCH=32
# GEMINI_CHAT_MODEL=gemini-3.5-flash
# PDF extraction backend: "gemini" (uses Gemini Flash — handles Amharic natively)
# or "native" (PyMuPDF + Tesseract OCR fallback — free but needs tesseract-ocr-amh)
INGEST_EXTRACTOR=gemini

# ─── OpenAI ───────────────────────────────────────────────────────────────────
# Required for RAG answer synthesis (replaces Gemini chat)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
# Optional: override the default chat model (default: gpt-5.5)
# OPENAI_CHAT_MODEL=gpt-5.5

# ─── Authentication (Better Auth) ────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-in-production

# Optional: `npm run seed:superadmin` (apps/web) — first superadmin bootstrap
# SUPERADMIN_EMAIL=admin@awaqi.local
# SUPERADMIN_PASSWORD=ChangeMeStrong123!
# SUPERADMIN_NAME=Superadmin

# ─── Frontend (Next.js) ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── API (FastAPI) ───────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3100
SESSION_TOKEN_SECRET=dev-session-token-secret-change-me
MAX_UPLOAD_BYTES=10485760

# ─── MoR scraper (daily job + admin POST /v1/admin/scrape — AWA-5 / AWA-11) ───
# SCRAPER_SCHEDULER_ENABLED=true
# SCRAPER_CRON_HOUR=0
# SCRAPER_CRON_MINUTE=0
# MOR_API_BASE_URL=https://www.mor.gov.et/api
# MOR_SCRAPE_SEED_URLS=https://www.mor.gov.et/custom-law-proclamation,https://www.mor.gov.et/domestic-law-regulation,https://www.mor.gov.et/domestic-law-directive,https://www.mor.gov.et/domestic-law-proclamation,https://www.mor.gov.et/custome-law-regulation,https://www.mor.gov.et/custome-law-directive
# MOR_SCRAPE_MAX_LINKS=30
# MOR_SCRAPER_USER_AGENT=AwaqiBot/1.0 (+https://github.com/aait/Awaqi)
# MoR TLS chain often fails in Python; default false so httpx can reach the API (set true if verify works)
# MOR_HTTP_SSL_VERIFY=false
# DOCUMENT_STORAGE_DIR=./data/documents
# OCR_LANGS=eng+amh  (requires tesseract-ocr-amh / tesseract-lang on the host)
# OCR_RENDER_SCALE=3.0
# OCR_CONFIDENCE_FAIL_THRESHOLD=0.5

─── Telegram channel scraper (@morwestaa — Telethon MTProto, not Bot API) ───
# Create app: https://my.telegram.org/apps
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# Generate session: uv run python scripts/telegram_gen_session.py
# TELEGRAM_SESSION_STRING=
# TELEGRAM_CHANNEL=morwestaa
# TELEGRAM_SCRAPE_SINCE=2026-04-01
# TELEGRAM_SCRAPE_MAX_MESSAGES=200

─── Telegram Bot (@ERATaxBot) ───────────────────────────────────────────────
Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
Base URL of the running FastAPI backend (no trailing slash)
TELEGRAM_API_BASE_URL=http://localhost:8000
Session TTL in seconds for Telegram users (default 24 hours = 86400)
TELEGRAM_SESSION_TTL=86400
# Timeout in seconds for the bot→API HTTP call (default 60 — LLM calls can be slow)
TELEGRAM_API_TIMEOUT=60

# ─── Rate Limiting ───────────────────────────────────────────────────────────
TRUST_X_FORWARDED_FOR=false
TRUSTED_PROXIES=
# When running the Telegram bot on the same host as the API, set:
#   TRUST_X_FORWARDED_FOR=true
#   TRUSTED_PROXIES=127.0.0.1
# This lets the bot pass X-Forwarded-For: telegram:{chat_id} so each
# Telegram user gets their own rate-limit bucket instead of sharing one IP.

# ─── Hugging Face ────────────────────────────────────────────────────────────
# Get a free read token at https://huggingface.co/settings/tokens
# Optional but gives higher rate limits and faster downloads for the E5 model.
HF_TOKEN=

# ─── Proactive Notifications ─────────────────────────────────────────────────
# Email via Mailtrap SMTP (sandbox for dev; switch to live credentials in prod)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=587
MAILTRAP_USERNAME=6c193e3a4e7684
MAILTRAP_PASSWORD=your-mailtrap-password-here
MAILTRAP_FROM_EMAIL=noreply@awaqi.et
MAILTRAP_FROM_NAME=Awaqi – Ethiopian Tax Advisory

# SMS via GeezSMS REST API
GEEZSMS_TOKEN=your-geezsms-token-here
GEEZSMS_SHORTCODE_ID=your-shortcode-id-here

# Notification scheduler defaults (configurable via admin UI)
# NOTIFICATION_SCHEDULER_ENABLED=false
# NOTIFICATION_INTERVAL_HOURS=1

# ─── Debug ───────────────────────────────────────────────────────────────────
DB_ECHO=false
