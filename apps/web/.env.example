# =============================================================================
# Awaqi Next.js (apps/web) — required environment variables
# =============================================================================
#
# WHERE TO PUT THIS FILE
# ----------------------
# next.config.ts sets envDir to the repository root. Next.js therefore loads
# .env, .env.local, .env.development, etc. from the MONOREPO ROOT, not from
# apps/web/. If DATABASE_URL_SYNC is missing there, Better Auth hits PostgreSQL
# with an invalid config and you may see:
#   SASL: SCRAM-SERVER-FIRST-MESSAGE: client password must be a string
#
# From repo root:
#   cp apps/web/.env.example .env
# Then edit .env with your real secrets.
#
# =============================================================================

# --- Database (sync URL for Better Auth + node-pg) -----------------------------
# Must be a postgresql:// URL (not postgresql+asyncpg). User/password must be
# present and correct for your local or deployed Postgres.
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/awaqi_db

# --- Better Auth -------------------------------------------------------------
# Production: required (32+ chars, high entropy). Generate with:
#   openssl rand -base64 32
# Development: optional — if unset or weak (e.g. placeholder below), a random
# secret is generated per dev server start (sessions reset on restart).
BETTER_AUTH_SECRET=change-me-in-production

# --- Public URLs (browser + server) -----------------------------------------
# Origin of the Next app — must match how users open the site (scheme + host + port).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# FastAPI backend (browser-side API client default).
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Optional: seed first superadmin (npm run seed:superadmin) --------------
# SUPERADMIN_EMAIL=admin@awaqi.local
# SUPERADMIN_PASSWORD=ChangeMeStrong123!
# SUPERADMIN_NAME=Superadmin
